<article
  class="product-card"
  data-product
  data-name="{{name}}"
  data-created="{{created}}"
  data-tags="{{json tags}}"
>
  <a class="product-card-link" href="/produkt/{{id}}/"
    ><div class="product-image">
      <img
        src="/produkt/{{images.0.small}}"
        srcset="/produkt/{{images.0.small}} 400w, /produkt/{{images.0.large}} 1024w"
        sizes="(max-width: 380px) calc(100vw - 32px), (max-width: 700px) calc((100vw - 44px) / 2), (max-width: 900px) calc((100vw - 84px) / 3), (max-width: 1100px) calc((100vw - 116px) / 3), (max-width: 1200px) calc((100vw - 140px) / 4), (max-width: 1488px) calc((100vw - 188px) / 4), 325px"
        width="400"
        height="300"
        alt="{{name}}"
        loading="{{#if eagerImage}}eager{{else}}lazy{{/if}}"
        decoding="async"
      />
    </div>
    <div class="product-card-caption">
      <h3>{{name}}</h3>
      {{icon 'arrow'}}
    </div></a
  >
</article>
