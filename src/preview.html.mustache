<article
  class="product-card {{#if initiallyHidden}}catalog-hidden{{/if}}"
  data-product
  data-name="{{name}}"
  data-created="{{created}}"
  data-tags="{{json tags}}"
>
  <a class="product-card-link" href="/produkt/{{id}}/"
    ><div class="product-image">
      <img
        src="/produkt/{{images.0.small}}"
        srcset="/produkt/{{images.0.small}} 400w, /produkt/{{images.0.large}} 1024w"
        sizes="(max-width: 380px) calc(100vw - 32px), (max-width: 700px) 46vw, (max-width: 1100px) 30vw, 23vw"
        width="400"
        height="300"
        alt="{{name}}"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="product-card-caption">
      <h3>{{name}}</h3>
      {{icon 'arrow'}}
    </div></a
  >
</article>
