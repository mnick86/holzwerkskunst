<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f6" />
    <meta name="description" content="{{metaAttributes.ogDescription}}" />
    {{#if noindex}}
    <meta name="robots" content="noindex" />
    {{/if}}
    <link rel="canonical" href="{{metaAttributes.ogUrl}}" />
    <meta property="og:image" content="{{metaAttributes.ogImage}}" />
    <meta property="og:image:alt" content="{{metaAttributes.ogTitle}}" />
    <meta property="og:title" content="{{metaAttributes.ogTitle}}" />
    <meta property="og:site_name" content="{{metaAttributes.ogSiteName}}" />
    <meta property="og:type" content="{{metaAttributes.ogType}}" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content="{{metaAttributes.ogUrl}}" />
    <meta property="og:description" content="{{metaAttributes.ogDescription}}" />
    <title>{{metaAttributes.ogTitle}}</title>
    <link rel="stylesheet" href="/assets/site.css?v={{assetVersions.css}}" />
    <link
      rel="icon"
      href="/assets/favicon.png?v={{assetVersions.logo}}"
      type="image/png"
      sizes="48x48"
    />
    <script src="/assets/site.js?v={{assetVersions.js}}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    {{> header}}
    <main id="main" class="{{#if legal}}container legal-page{{/if}}">{{> (mainTemplate)}}</main>
    {{> footer}}
    <dialog id="contact-dialog" class="contact-dialog" aria-labelledby="contact-title">
      <button
        class="icon-button dialog-close"
        type="button"
        data-close-dialog
        aria-label="Kontakt schließen"
      >
        {{icon 'close'}}
      </button>
      <p class="eyebrow">Lass uns etwas Persönliches gestalten</p>
      <h2 id="contact-title">Deine Idee beginnt<br />mit einem Servus.</h2>
      <p data-contact-context>
        Erzähl uns von deinem Wunschprodukt, einem Motiv oder einem besonderen Anlass.
      </p>
      <a class="button" id="contact-email" href="{{inquiryUrl}}"
        >E-Mail-Anfrage öffnen {{icon 'arrow'}}</a
      >
      <p class="small-text">Öffnet dein E-Mail-Programm. Es wird nichts automatisch versendet.</p>
      <div class="contact-details">
        <strong>Alexandra Wiesmann &amp; Matthias Nick</strong
        ><span>Lindenstrasse 7a · 84030 Ergolding</span><a href="tel:+491716447548">0171 6447548</a
        ><a href="mailto:mnick86@gmail.com">mnick86@gmail.com</a>
      </div>
    </dialog>
    <p class="site-status" role="status" id="site-status"></p>
  </body>
</html>
