<div class="container category-page section">
  <nav class="breadcrumbs" aria-label="Brotkrumennavigation">
    <a href="/">Startseite</a><span aria-hidden="true">/</span><a href="/#produkte">Geschenkideen</a
    ><span aria-hidden="true">/</span
    ><span aria-current="page" data-category-label>{{categoryLabel tag}}</span>
  </nav>
  <div class="section-heading">
    <div>
      <p class="eyebrow">Eine persönliche Freude machen</p>
      <h1>Geschenkideen: <em data-category-label>{{categoryLabel tag}}</em></h1>
    </div>
    <a class="text-link" href="/#produkte">Alle Geschenkideen {{icon 'arrow'}}</a>
  </div>
  <div data-catalog data-initial-tag="{{tag}}">
    {{> category-nav}}
    <section id="produkte" class="catalog-section" aria-labelledby="catalog-title">
      {{> catalog}}
    </section>
  </div>
</div>
