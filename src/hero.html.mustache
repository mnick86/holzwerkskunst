<section class="container hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="small-rule"></span> Handgemacht in Niederbayern</p>
    <h1 id="hero-title">Persönliche Geschenke.<br /><em>Mit Liebe gemacht.</em></h1>
    <p class="hero-description">
      Individuelle Holzgravuren und liebevoll gestaltete Geschenkideen – einzigartig wie die
      Menschen, für die sie bestimmt sind.
    </p>
    <div class="button-row">
      <a class="button" href="#produkte">Produkte entdecken {{icon 'arrow'}}</a
      ><a class="text-link" href="{{inquiryUrl}}" data-contact
        >Individuell anfragen <span aria-hidden="true">↗</span></a
      >
    </div>
    <p class="hero-note">Für besondere Menschen. Und die kleinen Momente dazwischen.</p>
  </div>
  <figure class="hero-visual">
    <a href="/#produkte" aria-label="Geschenkideen entdecken"
      ><img
        src="{{heroImage}}"
        srcset="{{heroJpegSrcset}}"
        sizes="(max-width: 700px) calc(100vw - 32px), (max-width: 760px) calc(100vw - 48px), (max-width: 900px) calc((100vw - 76px) / 2), (max-width: 960px) calc((100vw - 108px) / 2), (max-width: 1100px) calc((100vw - 116px) / 2), (max-width: 1200px) calc((100vw - 144px) / 2), (max-width: 1488px) calc((100vw - 192px) / 2), 648px"
        width="1672"
        height="941"
        alt="Lichtdurchflutete Holzwerkstatt mit Werkbank, Holzgravuren und Lasergerät"
        fetchpriority="high"
    /></a>
    <figcaption>
      <span>Natürlich besonders.<small>Holz, das deine Geschichte erzählt.</small></span
      ><a href="/#produkte" class="icon-button" aria-label="Geschenkideen entdecken"
        >{{icon 'arrow'}}</a
      >
    </figcaption>
  </figure>
</section>
