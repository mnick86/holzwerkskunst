{{> hero}} {{> category-nav}}
<div data-catalog data-initial-tag="">
  <section class="container catalog-section" id="produkte" aria-labelledby="catalog-title">
    {{> catalog}}
  </section>
</div>
{{> personalization}}
<section class="about-section" id="ueber-uns" aria-labelledby="about-title">
  <div class="container about-layout">
    {{> about-photo}}
    <div class="about-copy">
      <p class="eyebrow">Das sind wir <span class="small-rule"></span></p>
      <h2 id="about-title">Mit Holz, Herz<br />und vielen Ideen.</h2>
      <p>
        Wir sind Alexandra Wiesmann &amp; Matthias Nick. Gemeinsam betreiben wir Holzwerkskunst und
        teilen die Leidenschaft für individuelle Geschenkideen und liebevoll gestaltete Unikate. In
        unserer kleinen Werkstatt in Niederbayern entstehen mit Kreativität, Sorgfalt und viel Liebe
        zum Detail persönliche Geschenke aus Holz. Jedes Stück wird mit dem Wunsch gestaltet,
        besondere Momente noch ein bisschen schöner zu machen.
      </p>
      <a class="button" href="/ueber-uns.html">Mehr über uns {{icon 'arrow'}}</a>
    </div>
  </div>
</section>
