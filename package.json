{
  "name": "holzwerkskunst",
  "version": "0.0.0",
  "scripts": {
    "test": "npm run test:seo && npm run test:descriptions && npm run test:site && npm run test:image",
    "start": "http-server ./dist/bootstrap/ --port 4200",
    "prestart:image": "npm run build:image",
    "start:image": "http-server dist/bootstrap/image -a 127.0.0.1 -p 4201 -c-1 -o /",
    "build:image": "node image-studio/build.mjs",
    "test:image": "node --test image-studio/test/studio.test.mjs image-studio/test/costs.test.mjs image-studio/test/github.test.mjs image-studio/test/ui.test.mjs",
    "transform": "ts-node transform.ts",
    "describe:images": "ts-node scripts/generate-image-descriptions.ts",
    "test:descriptions": "node --test scripts/image-descriptions.test.mjs scripts/transform.test.mjs",
    "mustache": "ts-node mustache.ts",
    "prettier": "prettier --write .",
    "check": "ts-node check.ts",
    "check:site": "node scripts/check-site.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test:seo": "node --test scripts/seo.test.mjs",
    "test:site": "node --test scripts/site.test.mjs scripts/gallery.test.mjs",
    "check:branding": "node scripts/check-branding.mjs"
  },
  "private": true,
  "dependencies": {
    "image-size": "^1.1.1",
    "octokit": "^5.0.5",
    "openai": "^7.45.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.5",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.9",
    "http-server": "^14.1.1",
    "jsdom": "^31.0.0",
    "mustache": "^4.2.0",
    "prettier": "^3.1.1",
    "sharp": "^0.35.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.2.2",
    "yaml": "^2.9.1"
  }
}
